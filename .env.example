# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Providers: "openai" uses the API, "local" is the deterministic offline provider.
AGENTCARD_LLM_PROVIDER=openai
AGENTCARD_EMBED_PROVIDER=openai

AGENTCARD_ENRICH_MODEL=gpt-4.1
AGENTCARD_CHEAP_MODEL=gpt-4.1-mini
AGENTCARD_EMBED_MODEL=text-embedding-3-small

# Any OpenAI-compatible endpoint. Leave blank for OpenAI itself; set these to
# run the whole pipeline against a self-hosted or vendor-provided model without
# a code change.
AGENTCARD_LLM_BASE_URL=
AGENTCARD_EMBED_BASE_URL=

# Which catalogue variant to operate on: spec_rich or typical.
AGENTCARD_VARIANT=spec_rich

# Hard stop. The runner aborts before exceeding this (USD).
AGENTCARD_BUDGET_USD=5.00
