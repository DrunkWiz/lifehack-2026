# Copy this file to `secrets.toml` in this same folder and fill in your key.
# `secrets.toml` is gitignored — never commit a real key.
#
# On Streamlit Community Cloud, don't use a file at all:
# add the same key/value pairs under App settings -> Secrets.

OPENAI_API_KEY = "sk-..."

# Optional. Hard spending cap in USD; the app refuses further API calls once
# the ledger in .cache/spend.json reaches it. Defaults to 5.00 if unset.
AGENT_BUDGET_USD = 5.00
